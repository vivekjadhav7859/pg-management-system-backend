# Never commit real Razorpay credentials. Use test-mode values outside production.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_secret

# Create these yearly plans in the Razorpay Dashboard first (period=yearly, interval=1).
RAZORPAY_PLAN_BASIC_ANNUAL=plan_replace_me
RAZORPAY_PLAN_SILVER_ANNUAL=plan_replace_me
RAZORPAY_PLAN_GOLD_ANNUAL=plan_replace_me
RAZORPAY_PLAN_PLATINUM_ANNUAL=plan_replace_me

# Amounts are in paise and must exactly match the corresponding Razorpay plan.
PLAN_BASIC_ANNUAL_AMOUNT=299900
PLAN_SILVER_ANNUAL_AMOUNT=499900
PLAN_GOLD_ANNUAL_AMOUNT=799900
PLAN_PLATINUM_ANNUAL_AMOUNT=1199900

SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_TRIAL_PROPERTY_LIMIT=1
